---
import "../styles/try-now.css";

const apiBase = import.meta.env.PUBLIC_SCREENING_API_BASE ||
  "https://pelliscope-eu-backend-144224247557.europe-west2.run.app";
const appCheckSiteKey = import.meta.env.PUBLIC_FIREBASE_APP_CHECK_SITE_KEY || "";
const firebaseConfig = JSON.stringify({
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY || "AIzaSyAz06l2w-vTBUXa3PHQ5MqiH1ITCFh2blE",
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN || "pelliscope-eu-prod.firebaseapp.com",
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || "pelliscope-eu-prod",
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET || "pelliscope-eu-prod.firebasestorage.app",
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || "144224247557",
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID || "1:144224247557:web:acf853194c7d6e7a2aa16c"
});
---

<div
  class="try-now"
  data-try-now
  data-api-base={apiBase}
  data-app-check-site-key={appCheckSiteKey}
  data-firebase-config={firebaseConfig}
  hidden
>
  <div class="try-now-backdrop" data-try-now-dismiss aria-hidden="true"></div>
  <section
    class="try-now-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="try-now-title"
    aria-describedby="try-now-description"
    tabindex="-1"
  >
    <header class="try-now-header">
      <a class="try-now-brand" href="/" aria-label="PelliScope home">
        <span><img src="/brand/pelliscope.png" alt="" /></span>
        <strong>PelliScope</strong>
      </a>
      <p>Instant AI screening</p>
      <button class="try-now-close" type="button" data-try-now-close aria-label="Close screening">×</button>
    </header>

    <div class="try-now-body">
      <div class="try-now-intro" data-try-upload-view>
        <p class="try-now-kicker">TRY IT NOW</p>
        <h2 id="try-now-title">Show us what changed.</h2>
        <p id="try-now-description">
          Add up to three clear skin photographs. You can include a short note, but nothing else is required.
        </p>

        <div class="try-now-drop" data-try-dropzone tabindex="0" role="button" aria-label="Choose skin photographs">
          <input data-try-file-input type="file" accept="image/jpeg,image/png,image/webp" multiple tabindex="-1" />
          <span class="try-now-add" aria-hidden="true">+</span>
          <strong>Add skin photographs</strong>
          <small>Camera, JPG, PNG or WebP · 1–3 images</small>
        </div>

        <div class="try-now-selected" data-try-selected hidden aria-live="polite"></div>

        <label class="try-now-note">
          <span>Anything you want to add? <small>Optional · not used to alter the AI result</small></span>
          <textarea data-try-concern maxlength="500" rows="3" placeholder="For example: appeared yesterday and feels itchy"></textarea>
        </label>

        <label class="try-now-confirm">
          <input data-try-confirm type="checkbox" />
          <span>
            I have the right to use these images and agree that the photographs and AI screening may be stored in
            PelliScope’s protected Community review queue. I understand this is informational, not a diagnosis.
          </span>
        </label>

        <p class="try-now-privacy">
          Images are saved privately for moderation. They reach the Doqlin partner API only after administrator
          approval. <a href="/privacy.html">Privacy</a>
        </p>

        <div class="try-now-error" data-try-error role="alert" hidden></div>

        <button class="try-now-submit" data-try-submit type="button" disabled>
          Screen images <span aria-hidden="true">→</span>
        </button>
      </div>

      <div class="try-now-loading" data-try-loading-view hidden aria-live="polite">
        <div class="try-now-scan" aria-hidden="true"><span></span><i></i></div>
        <p class="try-now-kicker">AI SCREENING</p>
        <h2>Reviewing your photographs…</h2>
        <p data-try-loading-message>Checking image clarity and preparing the LiteRT screening engine.</p>
        <div class="try-now-loading-line"><span></span></div>
        <small>The first screening after a quiet period may take longer while the secure service starts.</small>
      </div>

      <div class="try-now-results" data-try-result-view tabindex="-1" hidden>
        <div class="try-now-result-heading">
          <div>
            <p class="try-now-kicker">FIRST SCREEN READY</p>
            <h2>Your AI-assisted screening</h2>
          </div>
          <span class="try-now-reference" data-try-reference></span>
        </div>

        <div class="try-now-result-grid">
          <article class="try-now-signal" data-try-signal-card>
            <span>Infectious signal</span>
            <strong data-try-signal-label>—</strong>
            <div class="try-now-meter"><i data-try-signal-meter></i></div>
            <small data-try-signal-probability></small>
          </article>

          <article class="try-now-quality-summary">
            <span>Photograph quality</span>
            <strong data-try-quality-summary>—</strong>
            <small>Automated focus, light and resolution checks</small>
          </article>
        </div>

        <article class="try-now-community-status">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Submitted to the Doqlin Community queue</strong>
            <p>Your protected packet is pending administrator moderation. It is not publicly published yet.</p>
            <small data-try-community-reference></small>
          </div>
        </article>

        <section class="try-now-section" aria-labelledby="try-match-title">
          <div class="try-now-section-heading">
            <h3 id="try-match-title">Possible visual matches</h3>
            <span>Not a diagnosis</span>
          </div>
          <ol class="try-now-matches" data-try-matches></ol>
        </section>

        <details class="try-now-quality-details">
          <summary>Review photograph quality</summary>
          <div data-try-quality-list></div>
        </details>

        <section class="try-now-guidance" aria-labelledby="try-guidance-title">
          <h3 id="try-guidance-title" data-try-guidance-title>What to do next</h3>
          <ul data-try-guidance-list></ul>
        </section>

        <p class="try-now-disclaimer" data-try-disclaimer></p>

        <div class="try-now-result-actions">
          <a class="try-now-consult" href="https://app.pelliscope.eu/?source=try-now">
            Consult a specialist <span aria-hidden="true">→</span>
          </a>
          <button type="button" data-try-reset>Screen another concern</button>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import "../scripts/try-now.ts";
</script>
