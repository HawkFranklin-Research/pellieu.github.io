<div class="clinician-demo" data-clinician-demo>
  <div class="demo-ribbon">INTERFACE DEMONSTRATION · NO LIVE CLINICIAN OR PATIENT DATA</div>
  <div class="dashboard-window">
    <div class="window-bar">
      <span class="window-brand"><img src="/brand/pelliscope.png" alt="" /> PelliScope <b>Clinician</b></span>
      <div class="window-actions"><span>Available</span><i class="availability-toggle"></i><b>AM</b></div>
    </div>
    <div class="dashboard-body">
      <aside class="dashboard-nav" aria-hidden="true">
        <span class="nav-glyph active">⌁</span>
        <span class="nav-glyph">◎</span>
        <span class="nav-glyph">↗</span>
        <span class="nav-glyph">€</span>
      </aside>
      <div class="dashboard-content">
        <div class="dashboard-heading">
          <div><small>TODAY</small><h3>Your clinical workspace</h3></div>
          <span class="case-alert"><i></i> New case</span>
        </div>

        <div class="dashboard-grid">
          <div class="case-queue">
            <div class="queue-head"><span>READY FOR REVIEW</span><b>3 cases</b></div>
            <article class="queue-card active">
              <span class="case-avatar">P</span>
              <div><strong>Skin concern · Forearm</strong><small>3 photos · intake complete</small></div>
              <span class="case-time">Now</span>
            </article>
            <article class="queue-card">
              <span class="case-avatar alt">P</span>
              <div><strong>Follow-up · Hand</strong><small>2 photos · previous case</small></div>
              <span class="case-time">14m</span>
            </article>
            <article class="queue-card subdued">
              <span class="case-avatar soft">P</span>
              <div><strong>Skin concern · Neck</strong><small>4 photos · intake complete</small></div>
              <span class="case-time">31m</span>
            </article>
          </div>

          <div class="case-detail">
            <div class="detail-top"><span>CASE PS-2048</span><b>Structured intake</b></div>
            <div class="detail-photos">
              <div class="detail-photo main">
                <img src="/samples/skin-case/case-context.webp" alt="" loading="lazy" decoding="async" />
                <i></i><span>Selected view</span>
              </div>
              <div class="detail-photo">
                <img src="/samples/skin-case/case-close.webp" alt="" loading="lazy" decoding="async" />
                <i></i>
              </div>
              <div class="detail-photo">
                <img src="/samples/skin-case/case-angle.webp" alt="" loading="lazy" decoding="async" />
                <i></i>
              </div>
            </div>
            <div class="detail-summary">
              <span>AI-ASSISTED SUMMARY</span>
              <p>Visible pattern, timing and reported symptoms organised for clinician interpretation.</p>
            </div>
            <div class="detail-actions">
              <button type="button" tabindex="-1">Open case</button>
              <button type="button" tabindex="-1">Request follow-up</button>
            </div>
          </div>
        </div>

        <div class="earnings-strip">
          <div><span class="earnings-icon">€</span><p><small>YOUR CONSULTATION FEE</small><strong>Set your professional fee</strong></p></div>
          <span class="earning-stage is-active" data-earning-stage="0"><i></i>Case received</span>
          <span class="earning-stage" data-earning-stage="1"><i></i>Consultation complete</span>
          <span class="earning-stage" data-earning-stage="2"><i></i>Ready for payout</span>
        </div>
      </div>
    </div>
  </div>
  <div class="dashboard-caption">
    <span>ILLUSTRATIVE WORKFLOW</span>
    <p>Availability → prepared case → consultation → professional fee</p>
  </div>
</div>
