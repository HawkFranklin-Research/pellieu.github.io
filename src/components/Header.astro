---
interface Props {
  active?: "home" | "doctors" | "clinics";
  tone?: "dark" | "light";
}

const { active = "home", tone = "dark" } = Astro.props;
---

<header class:list={["site-header", `header-${tone}`]} data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="PelliScope home">
      <span class="brand-mark"><img src="/brand/pelliscope.png" alt="" /></span>
      <span>PelliScope</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/#how-it-works">How it works</a>
      <a href="/doctors.html" aria-current={active === "doctors" ? "page" : undefined}>For doctors</a>
      <a href="/clinics.html" aria-current={active === "clinics" ? "page" : undefined}>For clinics</a>
    </nav>

    <div class="header-actions">
      <button class="header-cta" type="button" data-try-now-open>Try now <span aria-hidden="true">→</span></button>
      <a class="header-clinic-cta" href="https://app.pelliscope.eu/clinician/register" target="_blank" rel="noopener">
        <span>Register your clinic</span>
        <small>I’m a dermatologist</small>
      </a>
      <a class="header-login" href="https://app.pelliscope.eu/clinician" target="_blank" rel="noopener">Clinician login ↗</a>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span class="sr-only">Open menu</span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden>
    <a href="/#how-it-works">How it works</a>
    <a href="/doctors.html">For doctors</a>
    <a href="/clinics.html">For clinics</a>
    <button type="button" data-try-now-open>Try now →</button>
    <a href="https://app.pelliscope.eu" target="_blank" rel="noopener">App ↗</a>
    <a href="https://app.pelliscope.eu/clinician/register" target="_blank" rel="noopener">
      Register your clinic <small>I’m a dermatologist</small>
    </a>
    <a href="https://app.pelliscope.eu/clinician" target="_blank" rel="noopener">Clinician login ↗</a>
  </nav>
  <div class="scroll-meter" data-scroll-meter></div>
</header>
