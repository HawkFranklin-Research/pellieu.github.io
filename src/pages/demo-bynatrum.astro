      <main class="deck-reel" data-reel>
        <section class="deck-scene scene-patient demo-opening is-active" id="opening" data-tone="light" aria-labelledby="opening-title">
          <div class="demo-opening-grid" aria-hidden="true"></div>
          <div class="scene-inner patient-layout demo-opening-layout">
            <div class="scene-copy patient-copy demo-opening-copy">
              <div class="demo-product-lockup scene-reveal" aria-label="PelliScope">
                <img src="/demo-bynatrum/brand/pelliscope.png" alt="" />
                <strong>PelliScope</strong>
              </div>
              <p class="scene-kicker scene-reveal">Pre-Medical Digital Inquiry</p>
              <h1 id="opening-title" class="scene-reveal">Dermatology<br />Telemedicine <em>Platform.</em></h1>
              <p class="scene-lede scene-reveal">
                Preliminary AI-assisted screening for 25 dermatological conditions—organising photographs and context before a clinical visit or teleconsultation.
              </p>
              <div class="demo-opening-benefits scene-reveal" aria-label="PelliScope platform benefits">
                <span>Save patient time</span>
                <span>Prepare the clinician</span>
                <span>Structured alternative to symptom search</span>
              </div>
              <strong class="demo-validation scene-reveal">80.2% Accuracy on Clinical Validation</strong>
              <p class="clinical-boundary scene-reveal">AI-assisted screening supports preparation and routing. It is not a diagnosis or a medical device.</p>
              <div class="patient-steps scene-reveal" role="group" aria-label="Patient journey stages">
                <button class="is-active" type="button" data-phone-step="0"><span>01</span><strong>Concern</strong></button>
                <button type="button" data-phone-step="1"><span>02</span><strong>Photos</strong></button>
                <button type="button" data-phone-step="2"><span>03</span><strong>AI Screening</strong></button>
                <button type="button" data-phone-step="3"><span>04</span><strong>Consultation</strong></button>
              </div>
              <button class="scroll-cue scene-reveal" type="button" data-next aria-label="Continue to the care journey">
                <i aria-hidden="true">↓</i><span>Continue</span>
              </button>
            </div>

            <div class="phone-story scene-reveal" data-phone-story aria-describedby="phone-story-description">
              <p class="sr-only" id="phone-story-description">A four-step interface shows an urgent skin lesion photograph, digital image submission, AI-assisted preliminary screening and teleconsultation selection.</p>
              <div class="phone-aura" aria-hidden="true"></div>
              <div class="phone-shell" aria-hidden="true">
                <div class="phone-hardware"><span></span><i></i></div>
                <div class="phone-display">
                  <div class="phone-status"><span>10:24</span><span>● 5G ▰</span></div>
                  <div class="phone-app-bar"><img src="/demo-bynatrum/brand/pelliscope.png" alt="" /><strong>PelliScope</strong><span>Private</span></div>
                  <div class="phone-screens">
                    <section class="phone-screen capture-camera-screen is-active" data-phone-screen="0">
                      <p class="screen-step">CAPTURE IMAGE · 01</p>
                      <h3>Urgent Skin Lesion Test</h3>
                      <div class="camera-capture-view">
                        <img src="/demo-bynatrum/case/context.jpeg" alt="" />
                        <span class="camera-focus-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                        <span class="camera-flash" aria-hidden="true"></span>
                        <div class="camera-guidance"><span></span><p><strong>Good light</strong>Hold steady</p></div>
                      </div>
                      <div class="camera-controls" aria-hidden="true">
                        <span class="camera-mode">PHOTO</span>
                        <button class="camera-shutter" type="button" tabindex="-1"><i></i></button>
                        <span class="camera-thumbnail"><img src="/demo-bynatrum/case/context.jpeg" alt="" /></span>
                      </div>
                      <div class="camera-captured"><i>✓</i><p><strong>Image captured</strong><span>Ready for the closer view</span></p></div>
                    </section>

                    <section class="phone-screen" data-phone-screen="1">
                      <p class="screen-step">ADD PHOTOGRAPHS · 02</p>
                      <h3>Submit images digitally.</h3>
                      <div class="phone-photo-grid">
                        <figure><img src="/demo-bynatrum/case/context.jpeg" alt="" /><span>Context</span><i>✓</i></figure>
                        <figure><img src="/demo-bynatrum/case/angled.jpeg" alt="" /><span>Angled</span><i>✓</i></figure>
                        <div><b>+</b><span>Add view</span></div>
                      </div>
                      <div class="capture-guide"><i></i><p><strong>Good light detected</strong>Keep the area in focus.</p></div>
                      <button type="button" tabindex="-1">Review photographs <span>→</span></button>
                    </section>

                    <section class="phone-screen direction-screen screening-result-screen" data-phone-screen="2">
                      <p class="screen-step">AI SCREENING · 03</p>
                      <div class="screening-verdict">
                        <span aria-hidden="true">!</span>
                        <div><small>PRELIMINARY SIGNAL</small><strong>Infectious</strong></div>
                      </div>
                      <div class="signal-scores" aria-label="Illustrative infectious and non-infectious scores">
                        <div class="signal-score infectious-score"><p><span>Infectious</span><strong>81%</strong></p><i><b></b></i></div>
                        <div class="signal-score noninfectious-score"><p><span>Non-infectious</span><strong>23%</strong></p><i><b></b></i></div>
                      </div>
                      <div class="possible-matches demo-possible-matches">
                        <p>TOP POSSIBLE MATCHES <small>Illustrative</small></p>
                        <ol>
                          <li><span>01</span><strong>Herpes Zoster</strong><b>92%</b><i style="--match: 92%"></i></li>
                          <li><span>02</span><strong>Herpes Simplex</strong><b>68%</b><i style="--match: 68%"></i></li>
                          <li><span>03</span><strong>Viral Exanthem</strong><b>41%</b><i style="--match: 41%"></i></li>
                        </ol>
                      </div>
                      <small>Informational screening · not a diagnosis</small>
                    </section>

                    <section class="phone-screen connected-screen clinician-list-screen" data-phone-screen="3">
                      <p class="screen-step">CONSULTATION · 04</p>
                      <h3>Available for teleconsultation.</h3>
                      <p class="clinician-list-copy">Choose a verified dermatologist to review this screening case.</p>
                      <div class="teleconsult-list demo-teleconsult-list">
                        <article>
                          <span class="teleconsult-avatar">AM</span>
                          <div><strong>Dr. Aarav Mehta</strong><small>General dermatology · Verified</small><em>8 yrs experience · ~2h response</em></div>
                          <b>Available now</b>
                        </article>
                        <article>
                          <span class="teleconsult-avatar alt">NS</span>
                          <div><strong>Dr. Nisha Shah</strong><small>Dermatology · Verified</small><em>11 yrs experience · Today</em></div>
                          <b>Available today</b>
                        </article>
                        <article>
                          <span class="teleconsult-avatar soft">RI</span>
                          <div><strong>Dr. Riya Iyer</strong><small>Clinical dermatology · Verified</small><em>6 yrs experience · ~4h response</em></div>
                          <b>Available now</b>
                        </article>
                      </div>
                      <button type="button" tabindex="-1">View teleconsultation <span>→</span></button>
                    </section>
                  </div>
                  <span class="phone-home-indicator"></span>
                </div>
              </div>
              <div class="phone-controls">
                <div class="phone-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <button type="button" data-phone-toggle aria-label="Pause patient journey animation"><span class="pause">Ⅱ</span><span class="play">▶</span></button>
              </div>
            </div>
          </div>
        </section>

        <section class="deck-scene demo-journey-scene" id="patient-journey" data-tone="light" aria-label="Digital submission, AI screening and consultation">
          <div class="scene-inner demo-journey-layout">
            <div class="journey-grid clinic-journey-grid demo-journey-grid">
              <article class="journey-step scene-reveal">
                <div class="journey-boundary">
                  <span class="step-number">01</span>
                  <div><h3>Digital Submission</h3><p>Photographs and context are organised before the clinical visit.</p></div>
                </div>
                <div class="journey-phone journey-phone-capture" role="img" aria-label="Digital photograph and symptom submission">
                  <div class="journey-phone-hardware" aria-hidden="true"><span></span></div>
                  <div class="journey-phone-screen">
                    <div class="journey-phone-status" aria-hidden="true"><span>09:41</span><span>5G ▰</span></div>
                    <div class="journey-phone-bar"><span><img src="/demo-bynatrum/brand/pelliscope.png" alt="" /></span><strong>PelliScope</strong><small>Private</small></div>
                    <div class="journey-phone-content capture-scene">
                      <p>SKIN CHECK · 02</p><h4>Submit images digitally.</h4>
                      <div class="journey-photo-pair">
                        <figure><img src="/samples/skin-case/case-context.webp" alt="" /><figcaption>Context</figcaption></figure>
                        <figure><img src="/samples/skin-case/case-close.webp" alt="" /><figcaption>Closer</figcaption></figure>
                      </div>
                      <div class="journey-capture-note"><i></i><span><strong>Clear photographs</strong>Good light and focus detected</span></div>
                      <div class="journey-symptoms"><span>Itchy</span><span>2 days</span><span>Forearm</span></div>
                    </div>
                  </div>
                  <span class="journey-phone-home" aria-hidden="true"></span>
                </div>
                <div class="journey-step-copy"><h3>Send the concern securely.</h3><p>Add clear photographs and concise symptom context through a phone.</p></div>
              </article>

              <article class="journey-step scene-reveal">
                <div class="journey-boundary">
                  <span class="step-number">02</span>
                  <div><h3>AI Screening</h3><p>An informational first signal prepares the case without pretending to diagnose it.</p></div>
                </div>
                <div class="journey-phone journey-phone-signal" role="img" aria-label="AI-assisted preliminary screening result">
                  <div class="journey-phone-hardware" aria-hidden="true"><span></span></div>
                  <div class="journey-phone-screen">
                    <div class="journey-phone-status" aria-hidden="true"><span>09:41</span><span>5G ▰</span></div>
                    <div class="journey-phone-bar"><span><img src="/demo-bynatrum/brand/pelliscope.png" alt="" /></span><strong>PelliScope</strong><small>Private</small></div>
                    <div class="journey-phone-content signal-scene">
                      <p>AI SCREENING</p><h4>First signal ready.</h4>
                      <div class="journey-signal-photo"><img src="/samples/skin-case/case-angle.webp" alt="" /><span><i></i></span></div>
                      <div class="journey-signal-card"><div><small>INFECTIOUS SIGNAL</small><strong>Not elevated</strong></div><span>✓</span></div>
                      <div class="journey-result-lines"><i></i><i></i><i></i></div>
                      <small class="journey-disclaimer">Informational screening · not a diagnosis</small>
                    </div>
                  </div>
                  <span class="journey-phone-home" aria-hidden="true"></span>
                </div>
                <div class="journey-step-copy"><h3>Understand the first signal.</h3><p>Receive an AI-assisted preliminary screen that organises the concern.</p></div>
              </article>

              <article class="journey-step scene-reveal">
                <div class="journey-boundary">
                  <span class="step-number">03</span>
                  <div><h3>Consultation</h3><p>Continue through an in-person clinic visit or a private teleconsultation.</p></div>
                </div>
                <div class="journey-phone journey-phone-clinician" role="img" aria-label="In-person or telemedicine consultation selection">
                  <div class="journey-phone-hardware" aria-hidden="true"><span></span></div>
                  <div class="journey-phone-screen">
                    <div class="journey-phone-status" aria-hidden="true"><span>09:41</span><span>5G ▰</span></div>
                    <div class="journey-phone-bar"><span><img src="/demo-bynatrum/brand/pelliscope.png" alt="" /></span><strong>PelliScope</strong><small>Private</small></div>
                    <div class="journey-phone-content clinician-scene">
                      <p>CONSULTATION</p><h4>Choose how to continue.</h4>
                      <div class="journey-case-chip"><img src="/samples/skin-case/case-context.webp" alt="" /><span><strong>Prepared case</strong>Photos + screening context</span></div>
                      <article class="journey-clinician selected"><b>VC</b><span><strong>Teleconsultation</strong><small>Private video review</small></span><i>✓</i></article>
                      <article class="journey-clinician"><b>IP</b><span><strong>In-person visit</strong><small>Continue at the clinic</small></span></article>
                      <div class="journey-consent"><span>✓</span>The clinician receives the prepared case.</div>
                    </div>
                  </div>
                  <span class="journey-phone-home" aria-hidden="true"></span>
                </div>
                <div class="journey-step-copy"><h3>Continue with a professional.</h3><p>Choose an in-person appointment or teleconsultation after screening.</p></div>
              </article>
            </div>
          </div>
        </section>

        <section class="deck-scene scene-clinician-combined" id="clinician-workspace" data-tone="dark" aria-label="Clinician review workspace" data-clinician-phase="queue">
          <div class="clinician-combined-background" aria-hidden="true"></div>
          <div class="scene-inner clinician-combined-layout">
            <div class="clinician-phase-panel queue-phase-panel is-active" data-clinician-panel="queue">
              <div class="dashboard-stage scene-reveal" data-queue-demo>
                <p class="sr-only">A simulated review queue contains prepared dermatology cases with screening and urgency information.</p>
                <div class="interface-paper dashboard-paper" aria-hidden="true">
                  <header class="product-header">
                    <div class="product-brand"><img src="/demo-bynatrum/brand/pelliscope.png" alt="" /><span><strong>PelliScope</strong><small>Clinician workspace</small></span></div>
                    <div class="availability-pill"><i></i>Available for reviews</div>
                  </header>
                  <div class="queue-heading"><div><span>REVIEW QUEUE</span><h3><strong>3 new</strong> prepared cases</h3></div><button type="button" tabindex="-1">↻ Refresh</button></div>
                  <div class="queue-metrics">
                    <article data-queue-metric="new"><span>New review</span><strong>3</strong></article>
                    <article class="is-active" data-queue-metric="urgent"><span>Urgent</span><strong>1</strong></article>
                    <article class="is-active" data-queue-metric="infectious"><span>Infectious</span><strong>2</strong></article>
                    <article data-queue-metric="treatment"><span>Treatment sent</span><strong>1</strong></article>
                    <article data-queue-metric="follow"><span>Follow-up</span><strong>1</strong></article>
                  </div>
                  <div class="queue-filters"><span class="is-active">All cases</span><span>New review</span><span>Urgent</span><span>Follow-up</span><i>Search Patient ID</i></div>
                  <div class="case-queue">
                    <article class="queue-row is-active" data-queue-case data-queue-metric-key="urgent infectious">
                      <div class="queue-identity"><b>P</b><p><strong>PS-2048</strong><span>34y · Female · Today</span></p><em>Urgent</em></div>
                      <div class="queue-screen infectious"><i></i><p><strong>Infectious</strong><span>Insect Bite · 61%</span></p></div>
                      <span class="risk-badge high">High</span><b class="row-arrow">›</b>
                    </article>
                    <article class="queue-row" data-queue-case data-queue-metric-key="new">
                      <div class="queue-identity"><b>N</b><p><strong>PS-2051</strong><span>28y · Male · Today</span></p><em>New review</em></div>
                      <div class="queue-screen clear"><i></i><p><strong>Non-infectious</strong><span>Eczema · 58%</span></p></div>
                      <span class="risk-badge low">Low</span><b class="row-arrow">›</b>
                    </article>
                    <article class="queue-row" data-queue-case data-queue-metric-key="treatment">
                      <div class="queue-identity"><b>R</b><p><strong>PS-2054</strong><span>41y · Female · Yesterday</span></p><em>Treatment sent</em></div>
                      <div class="queue-screen clear"><i></i><p><strong>Non-infectious</strong><span>Allergic contact dermatitis · 49%</span></p></div>
                      <span class="risk-badge low">Low</span><b class="row-arrow">›</b>
                    </article>
                    <article class="queue-row" data-queue-case data-queue-metric-key="follow infectious">
                      <div class="queue-identity"><b>A</b><p><strong>PS-2057</strong><span>39y · Male · Yesterday</span></p><em>Follow-up</em></div>
                      <div class="queue-screen infectious"><i></i><p><strong>Infectious</strong><span>Folliculitis · 44%</span></p></div>
                      <span class="risk-badge moderate">Moderate</span><b class="row-arrow">›</b>
                    </article>
                  </div>
                  <footer class="simulation-label"><i></i>Simulated data · Interface demonstration</footer>
                </div>
              </div>
            </div>

            <div class="clinician-phase-panel review-phase-panel" data-clinician-panel="review">
              <div class="review-visual scene-reveal" data-clinical-demo data-case-state="infectious">
                <p class="sr-only">A simulated clinical record shows protected photographs, patient context, AI-assisted screening and clinician actions.</p>
                <div class="clinical-theatre" aria-hidden="true">
                  <div class="interface-paper queue-paper-peek"><span>REVIEW QUEUE</span><i></i><i></i><i></i></div>
                  <article class="interface-paper patient-paper">
                    <header class="case-header case-header-without-id">
                      <div class="case-meta"><span data-case-meta>34y · Female</span><i data-case-risk>High risk</i></div>
                    </header>
                    <div class="patient-record">
                      <section class="record-images">
                        <figure class="record-primary"><img data-case-main-image src="/demo-bynatrum/case/insect-bite-1.jpg" alt="" /></figure>
                        <div class="record-thumbs">
                          <figure class="is-active" data-case-thumb="0"><img data-case-image="0" src="/demo-bynatrum/case/insect-bite-1.jpg" alt="" /><span>Context</span></figure>
                          <figure data-case-thumb="1"><img data-case-image="1" src="/demo-bynatrum/case/insect-bite-2.jpg" alt="" /><span>Angled</span></figure>
                          <figure class="close-view" data-case-thumb="2"><img data-case-image="2" src="/demo-bynatrum/case/insect-bite-1.jpg" alt="" /><span>Closer</span></figure>
                        </div>
                        <div class="case-complaint"><span>PATIENT COMPLAINT</span><strong data-case-complaint>Itchy raised spots reported for two days.</strong><div data-case-chips><i>Itchy</i><i>2 days</i><i>Upper arm</i></div></div>
                      </section>
                      <section class="record-context">
                        <div class="screening-banner infectious" data-case-banner><i></i><p><strong data-case-screen-title>Infectious signal detected</strong><span data-case-screen-copy>Clinical review required promptly.</span></p></div>
                        <div class="differential-card">
                          <header><span>AI-ASSISTED DIFFERENTIALS</span><small>Screening context</small></header>
                          <div class="differential-row"><p><strong data-diff-name="0">Insect Bite</strong><span data-diff-value="0">61%</span></p><i><b data-diff-bar="0" style="--bar:61%"></b></i></div>
                          <div class="differential-row"><p><strong data-diff-name="1">Urticaria</strong><span data-diff-value="1">23%</span></p><i><b data-diff-bar="1" style="--bar:23%"></b></i></div>
                          <div class="differential-row"><p><strong data-diff-name="2">Folliculitis</strong><span data-diff-value="2">11%</span></p><i><b data-diff-bar="2" style="--bar:11%"></b></i></div>
                        </div>
                        <div class="care-timeline"><span>CARE TIMELINE</span><div><i></i><p><strong>Intake received</strong><small>Today · 09:24</small></p></div><div><i></i><p><strong>Prepared for review</strong><small>Today · 09:26</small></p></div></div>
                      </section>
                    </div>
                    <footer class="case-actions"><span>Clinical note</span><span>Prescribe</span><span>Request clinic visit</span></footer>
                  </article>
                  <article class="interface-paper screening-paper">
                    <span>SCREENING CONTEXT</span>
                    <div class="screening-verdict infectious" data-screening-paper><i></i><p><strong data-paper-title>Infectious</strong><small data-paper-copy>Signal for prompt review</small></p></div>
                    <div class="paper-score"><span>LEADING DIFFERENTIAL</span><strong data-paper-differential>Insect Bite</strong><i><b data-paper-bar style="--bar:61%"></b></i><small data-paper-percent>61%</small></div>
                    <p>AI-assisted screening supports preparation. Clinical interpretation remains with the dermatologist.</p>
                    <footer><i></i>Simulated data · Interface demonstration</footer>
                  </article>
                </div>
              </div>
            </div>

            <div class="clinician-phase-progress" aria-hidden="true"><i class="is-active"></i><i></i></div>
          </div>
        </section>

        <section class="deck-scene demo-evidence-scene" id="workflow-evidence" data-tone="dark" aria-label="Workflow comparison and model performance">
          <div class="demo-evidence-background" aria-hidden="true"></div>
          <div class="scene-inner demo-evidence-layout">
            <div class="developer-proof-grid clinic-proof-grid demo-proof-grid">
              <article class="developer-proof-card workflow-proof scene-reveal">
                <header><div><small>WORKFLOW COMPARISON</small><h3>Pre-consultation efficiency.</h3></div><span>+10 patients / 5hr shift</span></header>
                <div class="developer-workflow-compare">
                  <div>
                    <p><strong>Traditional (No AI)</strong><span>10 Min / Patient</span></p>
                    <div class="developer-timebar"><i>Consultation (10m)</i></div>
                    <b>6 Patients / Hour</b>
                  </div>
                  <div class="is-pelliscope">
                    <p><strong>With PelliScope</strong><span>~10 Min Total (Parallelized)</span></p>
                    <div class="developer-timebar split"><i>Preliminary screen (3m)</i><i>Focused consult (7m)</i></div>
                    <div class="developer-workflow-result"><small>AI triage saves 3 mins of discovery time per patient</small><b>8 Patients / Hour</b></div>
                  </div>
                </div>
