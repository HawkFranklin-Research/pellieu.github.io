  <body>
    <div class="deck-page demo-deck-page">
      <header class="deck-topbar is-light" data-topbar>
        <a class="deck-brand demo-deck-brand" href="/" aria-label="Back to the PelliScope Europe homepage">
          <img src="/demo-bynatrum/brand/hawkfranklin-emblem.png" alt="" />
          <strong><span>HawkFranklin</span> OÜ</strong>
        </a>

        <nav class="deck-progress" aria-label="Presentation sections">
          <button class="is-active" type="button" aria-label="Go to PelliScope introduction" aria-current="step"><span></span></button>
          <button type="button" aria-label="Go to the patient journey"><span></span></button>
          <button type="button" aria-label="Go to the clinician workspace"><span></span></button>
          <button type="button" aria-label="Go to workflow evidence"><span></span></button>
