---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ClinicianDashboard from "../components/ClinicianDashboard.astro";

const title = "PelliScope for Dermatologists | Community and digital practice";
const description =
  "Join an open clinical community for learning and contribution, or establish a verified digital dermatology practice with PelliScope.";
---

<BaseLayout title={title} description={description} canonical="https://pelliscope.eu/doctors.html">
  <Header active="doctors" />
  <main id="main-content">
    <section class="subpage-hero doctor-page-hero">
      <div class="subpage-glow" aria-hidden="true"></div>
      <div class="subpage-hero-inner section-shell">
        <div class="subpage-copy">
          <p class="eyebrow"><span></span>PelliScope for dermatologists</p>
          <h1>Your expertise.<br /><em>On your terms.</em></h1>
          <p>
            Join an open clinical community to learn, discuss and contribute—or establish a verified
            digital-clinic pilot where you can prepare availability and professional fees for a future
            country launch.
          </p>
          <div class="hero-actions">
            <a class="button button-primary magnetic" href="https://app.pelliscope.eu/community" target="_blank" rel="noopener">Join the open clinical community <span>↗</span></a>
            <a class="button button-outline" href="https://app.pelliscope.eu/clinician" target="_blank" rel="noopener">Set up your digital clinic <span>↗</span></a>
          </div>
          <a class="existing-clinician-link" href="https://app.pelliscope.eu/clinician" target="_blank" rel="noopener">Already registered? Clinician sign in ↗</a>
          <p class="subpage-micro">Professional verification is required for community access and before accepting patient consultations.</p>
        </div>
        <div class="subpage-visual"><ClinicianDashboard /></div>
      </div>
    </section>

    <section class="clinician-pathways-section" aria-labelledby="clinician-pathways-title">
      <div class="section-shell">
        <div class="clinician-pathways-heading">
          <div>
            <p class="eyebrow dark"><span></span>Two ways to take part</p>
            <h2 id="clinician-pathways-title">Contribute freely.<br /><em>Or build your practice.</em></h2>
          </div>
          <p>Choose the relationship with PelliScope that fits your time, goals and professional scope. You can begin with the community and establish a digital clinic later.</p>
        </div>

        <div class="clinician-pathways-grid">
          <article class="pathway-card pathway-community" data-reveal>
            <div class="pathway-card-top">
              <span>01 · OPEN COMMUNITY</span>
              <b>Free</b>
            </div>
            <div class="pathway-symbol community-symbol" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
            <h3>Learn. Review.<br />Contribute.</h3>
            <p>Review eligible, protected cases awaiting clinical availability. Exchange professional reasoning, learn from peers and contribute without opening a paid practice.</p>
            <ul>
              <li>Verified clinical community</li>
              <li>Voluntary educational contribution</li>
              <li>No consultation fee required</li>
            </ul>
            <a class="button button-dark magnetic" href="https://app.pelliscope.eu/community" target="_blank" rel="noopener">Join the open clinical community <span>↗</span></a>
          </article>

          <article class="pathway-card pathway-clinic" data-reveal>
            <div class="pathway-card-top">
              <span>02 · DIGITAL CLINIC</span>
              <b>Professional practice</b>
            </div>
            <div class="pathway-symbol clinic-symbol" aria-hidden="true"><i></i><b></b><span></span></div>
            <h3>Your practice,<br />online.</h3>
            <p>Prepare your hours, consultation workflow and professional fee for launch where PelliScope and your registration jurisdiction support paid care.</p>
            <ul>
              <li>Your availability and professional fee</li>
              <li>Assigned consultations and follow-up after launch</li>
              <li>Payments only where locally supported</li>
            </ul>
            <a class="button button-primary magnetic" href="https://app.pelliscope.eu/clinician" target="_blank" rel="noopener">Set up your digital clinic <span>↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="community-workflow-section" aria-labelledby="community-workflow-title">
      <div class="section-shell">
        <div class="community-workflow-copy">
          <p class="eyebrow"><span></span>How community review begins</p>
          <h2 id="community-workflow-title">When a case needs<br /><em>a wider clinical view.</em></h2>
          <p>Eligible, patient-consented and appropriately protected cases may be made available to verified members of the clinical community.</p>
        </div>
        <ol class="community-case-flow" aria-label="Open clinical community case workflow">
          <li><span>01</span><strong>Eligible patient case</strong><small>A structured concern enters PelliScope.</small></li>
          <li><span>02</span><strong>No clinician assigned</strong><small>A dermatologist is not currently available.</small></li>
          <li><span>03</span><strong>Protected community case</strong><small>Consent and access rules are applied.</small></li>
          <li><span>04</span><strong>Verified peer review</strong><small>Clinicians discuss and contribute voluntarily.</small></li>
          <li><span>05</span><strong>Learning and direction</strong><small>Contributions can help inform an appropriate next step.</small></li>
        </ol>
        <p class="community-boundary">Community discussion is educational and collaborative. It does not by itself create a treating-clinician relationship or replace formal diagnosis and care.</p>
      </div>
    </section>

    <section class="doctor-value-section" aria-labelledby="doctor-value-title">
      <div class="section-shell">
        <p class="eyebrow dark"><span></span>Digital clinic · A practice that fits around yours</p>
        <h2 id="doctor-value-title">Less administration.<br /><em>More clinical time.</em></h2>
        <div class="value-grid">
          <article><span>01</span><h3>Cases arrive prepared.</h3><p>Photographs, symptoms, duration and screening context stay together before review begins.</p></article>
          <article><span>02</span><h3>You control availability.</h3><p>Open remote consultation hours around your clinic, hospital, research or family schedule.</p></article>
          <article><span>03</span><h3>Your expertise creates value.</h3><p>Prepare a professional fee for completed consultations once payments and clinical service are enabled in your jurisdiction.</p></article>
        </div>
      </div>
    </section>

    <section class="doctor-flow-section" aria-labelledby="doctor-flow-title">
      <div class="section-shell doctor-flow-layout">
        <div>
          <p class="eyebrow"><span></span>The digital clinic flow</p>
          <h2 id="doctor-flow-title">From available hour to <em>completed care.</em></h2>
        </div>
        <ol class="doctor-flow-list">
          <li><span>01</span><p><strong>Open availability</strong><small>Choose when you are ready to receive cases.</small></p></li>
          <li><span>02</span><p><strong>Review the prepared case</strong><small>See photographs and context before patient contact.</small></p></li>
          <li><span>03</span><p><strong>Consult and decide</strong><small>Continue remotely or direct the patient to in-person care.</small></p></li>
          <li><span>04</span><p><strong>Complete the consultation</strong><small>Keep notes, response and professional fee in one workflow.</small></p></li>
        </ol>
      </div>
    </section>

    <section class="doctor-earn-section">
      <div class="section-shell earn-panel">
        <div>
          <p class="eyebrow dark"><span></span>Professional earnings</p>
          <h2>Set your fee.<br /><em>See every stage.</em></h2>
          <p>The interface is illustrative. Consultation payment, platform fee and payout status will remain visible where paid clinical service is launched.</p>
        </div>
        <div class="earn-flow" aria-label="Consultation earnings workflow">
          <article><span>CASE</span><strong>Consultation accepted</strong><i></i></article>
          <b>→</b>
          <article><span>CARE</span><strong>Review completed</strong><i></i></article>
          <b>→</b>
          <article><span>PAYOUT</span><strong>Your fee becomes eligible</strong><i></i></article>
        </div>
      </div>
    </section>

    <section class="network-cta">
      <div class="section-shell">
        <p class="eyebrow"><span></span>Open clinical community</p>
        <h2>Learn together.<br /><em>Contribute where care is waiting.</em></h2>
        <p>Join verified clinical peers reviewing eligible cases, exchanging professional reasoning and helping shape a responsible community around dermatology access.</p>
        <div class="network-actions">
          <a class="button button-primary magnetic" href="https://app.pelliscope.eu/community" target="_blank" rel="noopener">Join the open clinical community <span>↗</span></a>
          <a class="button button-outline" href="https://app.pelliscope.eu/clinician" target="_blank" rel="noopener">Set up your digital clinic <span>↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
