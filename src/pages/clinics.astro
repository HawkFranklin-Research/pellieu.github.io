---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "PelliScope for Clinics | A digital front door for dermatology";
const description =
  "Give patients a guided entry point for skin concerns and route organised cases into remote review or appropriate in-person care.";
---

<BaseLayout title={title} description={description} canonical="https://pelliscope.eu/clinics.html">
  <Header active="clinics" />
  <main id="main-content">
    <section class="subpage-hero clinic-page-hero">
      <div class="clinic-page-grid" aria-hidden="true"></div>
      <div class="subpage-hero-inner clinic-hero-inner section-shell">
        <div class="subpage-copy">
          <p class="eyebrow"><span></span>PelliScope for clinics</p>
          <h1>Your digital<br /><em>front door.</em></h1>
          <p>Let patients begin with photographs and structured intake before your team’s clinical time begins.</p>
          <div class="hero-actions">
            <a class="button button-primary magnetic" href="mailto:partnerships@hawkfranklin.in?subject=PelliScope%20Clinic%20Partnership">Discuss a clinic partnership <span>→</span></a>
            <a class="button button-outline" href="#clinic-workflow">See the workflow <span>↓</span></a>
          </div>
        </div>

        <div class="clinic-console" aria-label="Illustrative PelliScope clinic intake overview">
          <div class="console-bar"><span><img src="/brand/pelliscope.png" alt="" /> PelliScope <b>Clinic</b></span><i>Interface demonstration</i></div>
          <div class="console-body">
            <div class="console-metrics">
              <article><span>NEW INTAKES</span><strong>08</strong><small>Ready for routing</small></article>
              <article><span>REMOTE REVIEW</span><strong>05</strong><small>Within clinical scope</small></article>
              <article><span>CLINIC ROUTE</span><strong>03</strong><small>Examination needed</small></article>
            </div>
            <div class="console-list">
              <div class="console-list-head"><span>RECENT PATIENT INTAKES</span><span>ROUTE</span></div>
              <article><i class="intake-avatar">P</i><p><strong>Skin concern · Arm</strong><small>3 photos · answers complete</small></p><span class="route-chip remote">Remote review</span></article>
              <article><i class="intake-avatar alt">P</i><p><strong>Follow-up · Face</strong><small>2 photos · returning patient</small></p><span class="route-chip clinic">Clinic visit</span></article>
              <article><i class="intake-avatar soft">P</i><p><strong>Skin concern · Back</strong><small>4 photos · answers complete</small></p><span class="route-chip pending">Triage</span></article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="clinic-workflow-section" id="clinic-workflow" aria-labelledby="clinic-workflow-title">
      <div class="section-shell">
        <p class="eyebrow dark"><span></span>Before the first appointment</p>
        <h2 id="clinic-workflow-title">A better arrival<br /><em>for every skin concern.</em></h2>
        <div class="clinic-workflow">
          <article><span>01</span><div class="workflow-symbol entry"><i></i></div><h3>Patient entry</h3><p>Your branded link begins a guided intake from any phone.</p></article>
          <i>→</i>
          <article><span>02</span><div class="workflow-symbol prepare"><i></i><b></b></div><h3>Prepared case</h3><p>Photographs and context arrive in one consistent format.</p></article>
          <i>→</i>
          <article><span>03</span><div class="workflow-symbol route"><i></i><b></b></div><h3>Appropriate route</h3><p>Your team chooses remote review, follow-up or physical examination.</p></article>
        </div>
      </div>
    </section>

    <section class="clinic-benefits-section">
      <div class="section-shell clinic-benefits-layout">
        <div>
          <p class="eyebrow"><span></span>Designed around your practice</p>
          <h2>Digital access.<br /><em>Clinical control.</em></h2>
        </div>
        <div class="clinic-benefits">
          <article><span>YOUR PATIENT RELATIONSHIP</span><p>Patients enter through a clinic-linked experience while your team retains the care relationship.</p></article>
          <article><span>YOUR CLINICAL ROUTING</span><p>Remote suitability and next-step decisions remain with qualified professionals.</p></article>
          <article><span>YOUR SERVICE BOUNDARIES</span><p>Begin with a defined service, clinician group and region, then expand on your terms.</p></article>
        </div>
      </div>
    </section>

    <section class="network-cta clinic-network-cta">
      <div class="section-shell">
        <p class="eyebrow"><span></span>Clinic partnerships</p>
        <h2>Give your patients a clearer<br /><em>way to begin.</em></h2>
        <p>Talk to us about bringing PelliScope intake, remote review and appropriate in-person routing into your service.</p>
        <a class="button button-primary magnetic" href="mailto:partnerships@hawkfranklin.in?subject=PelliScope%20Clinic%20Partnership">Request a conversation <span>→</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
